#!/bin/sh

PIDFILE=/var/run/squeezelite.pid
CONFIG=/etc/squeezelite/config

get_laa_mac_address() {
	# MAC address of player converted to upper case locally administered MAC address.
	# x2:xx:xx:xx:xx:xx x6:xx:xx:xx:xx:xx xA:xx:xx:xx:xx:xx xE:xx:xx:xx:xx:xx
	/sbin/ifconfig eth0 2>&1 | grep -o -E '([[:xdigit:]]{1,2}:){5}[[:xdigit:]]{1,2}' | sed 's/[0-9A-Fa-f]:/E:/' | tr '[a-z]' '[A-Z]'
}

if [ -e $CONFIG ]; then
	. $CONFIG
else
	echo "Squeezelite configuration not found"
	exit 1
fi

case "$1" in
    start)
	if [ -s $PIDFILE ] && /bin/kill -0 $(cat $PIDFILE)
	then
		echo "Squeezelite is already running - start"
		exit 1
	fi

	# Save LAA MAC address to config if not already present.
	if [ -z "$MAC" ]; then
		MAC="-m $(get_laa_mac_address)"
		echo "MAC=\"${MAC}\"" >> $CONFIG
	fi

	echo "Starting Squeezelite"

	export ALSA_CONFIG_PATH=/usr/share/alsa/alsa.conf

	/usr/bin/squeezelite \
		$OPTIONS \
		$NAME $MAC $PRIORITY \
		$MAX_RATE $AUDIO_DEV \
		$BUFFER $CODEC $EXCLUDE_CODEC $ALSA_PARAMS \
		$LOG_FILE $LOG_LEVEL \
		$RESAMPLE $DOP $VISULIZER \
		$SERVER_IP
	
	;;

    stop)
	echo -n "Stopping"
	if [ -s $PIDFILE ]; then
		echo " Squeezelite"
		/bin/kill $(cat $PIDFILE)

		while [ -e $PIDFILE ]; do
			echo "waiting for stop to complete"
			sleep 1
		done
	else
		echo ""
	fi
	;;

	status)
	if [ -s $PIDFILE ] && /bin/kill -0 $(cat $PIDFILE)
	then
		echo "Squeezelite is running - status"
	else
		echo "Squeezelite is stopped - status"
		exit 1
	fi
	;;

   restart)
	$0 stop
	$0 start
	;;

    *)
	echo "Usage: $0 {start|stop|status|restart}"
	exit 1
esac

exit 0
